    <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><omgdc:Bounds x="244" y="117" width="36" height="36" /><bpmndi:BPMNLabel><omgdc:Bounds x="214" y="157" width="96" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
