    <bpmndi:BPMNShape id="T_Leeren_di" bpmnElement="T_Leeren"><omgdc:Bounds x="1003" y="99" width="118" height="72" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T_Gold_di" bpmnElement="T_Gold"><omgdc:Bounds x="1163" y="209" width="118" height="72" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="GW_Gold_di" bpmnElement="GW_Gold" isMarkerVisible="true"><omgdc:Bounds x="1357" y="110" width="50" height="50" /><bpmndi:BPMNLabel><omgdc:Bounds x="1327" y="164" width="110" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T_Archiv_di" bpmnElement="T_Archiv"><omgdc:Bounds x="1483" y="99" width="118" height="72" /></bpmndi:BPMNShape>
