  <!-- Dokument-Nr. BPMN-ITS-002-2026 | Einrichtung der Datenplattform – Übersicht (Ebene 2) | Version 1.0 (Entwurf) | Stand 05.10.2026
       Projekt Azure-Datenplattform (Bee Haven). Ebenen-Ansatz; Freigabe Projektleitung offen.
       Erzeugt mit organisation/Firmenprozesse/generator/bpmn_lib.py – Änderungen bitte im Generator vornehmen. -->
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Einrichtung der Datenplattform – Übersicht (Ebene 2) (BPMN-ITS-002-2026)" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_PL" name="Geschäftsführung / Projektleitung">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_K</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_FB" name="Fachbereich (Data Owner)">
        <bpmn:flowNodeRef>Anf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ende</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DA" name="Data Analyst">
        <bpmn:flowNodeRef>Regel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ana</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DE" name="Data Engineer">
        <bpmn:flowNodeRef>Pipe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Auto</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ADM" name="IT-Administration (Plattform)">
        <bpmn:flowNodeRef>Plat</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SYS" name="System (Azure)">
        <bpmn:flowNodeRef>Lauf</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Auftrag, Budgetrahmen">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Anf" name="Datenprodukt und Anforderungen festlegen (Kennzahlen, Qualität)">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Plat" name="Plattform bereitstellen: Ressourcen, Rechte, Budget (Schritte 0–6, 26, 28)">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:incoming>R0</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_K" name="Kosten und Rechte freigegeben?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>R0</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Pipe" name="Speicherstruktur und Pipelines bauen (Schritte 4, 7–14)">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Regel" name="Datenprofil prüfen, Fachregeln festlegen (zu Schritten 18–19)">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="NB" name="Notebooks: Bereinigung, Wetter, Gold (Schritte 15–23)">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:incoming>R1</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Auto" name="Automatisierung: Synapse, Gold-Pipeline, Trigger (Schritte 24–35)">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_A" name="Ergebnis abgenommen?">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:outgoing>R1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Lauf" name="Täglicher Lauf (BPMN-ITS-001)">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="Ana" name="Auswertung, Dashboard (N5, Folgeprojekt FP-2)">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Ende" name="Kennzahlen für Entscheidungen">
      <bpmn:incoming>F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Anf" />
    <bpmn:sequenceFlow id="F2" sourceRef="Anf" targetRef="Plat" />
    <bpmn:sequenceFlow id="F3" sourceRef="Plat" targetRef="GW_K" />
    <bpmn:sequenceFlow id="F4" name="ja" sourceRef="GW_K" targetRef="Pipe" />
    <bpmn:sequenceFlow id="F5" sourceRef="Pipe" targetRef="Regel" />
    <bpmn:sequenceFlow id="F6" sourceRef="Regel" targetRef="NB" />
    <bpmn:sequenceFlow id="F7" sourceRef="NB" targetRef="Auto" />
    <bpmn:sequenceFlow id="F8" sourceRef="Auto" targetRef="GW_A" />
    <bpmn:sequenceFlow id="F9" name="ja" sourceRef="GW_A" targetRef="Lauf" />
    <bpmn:sequenceFlow id="F10" sourceRef="Lauf" targetRef="Ana" />
    <bpmn:sequenceFlow id="F11" sourceRef="Ana" targetRef="Ende" />
    <bpmn:sequenceFlow id="R0" name="nein – anpassen" sourceRef="GW_K" targetRef="Plat" />
    <bpmn:sequenceFlow id="R1" name="nein – nacharbeiten" sourceRef="GW_A" targetRef="NB" />
  </bpmn:process>
